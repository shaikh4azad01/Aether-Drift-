<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#0f1822">
    <title>AETHER DRIFT</title>
    <style>
        :root {
            --bg-top: #0f1822;
            --bg-bottom: #1c2b3a;
            --sage: #8fb8a8;
            --sage-bright: #b4dcd0;
            --warm-gold: #f2e8cf;
            --terracotta: #d98a6c;
            --heart-red: #e87a7a;
            --text-main: #eef2f0;
            --text-muted: #9eb2ad;
            --glass-bg: rgba(16, 25, 34, 0.82);
            --glass-border: rgba(238, 242, 240, 0.18);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            user-select: none;
            -webkit-user-select: none;
            -webkit-touch-callout: none;
            -webkit-tap-highlight-color: transparent;
        }

        html, body {
            position: fixed;
            inset: 0;
            width: 100%;
            height: 100%;
            height: 100dvh;
            overflow: hidden;
            background-color: var(--bg-top);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Inter, sans-serif;
            color: var(--text-main);
            touch-action: none;
            overscroll-behavior: none;
        }

        #gameCanvas {
            position: fixed;
            inset: 0;
            display: block;
            width: 100%;
            height: 100%;
            height: 100dvh;
            z-index: 1;
            touch-action: none;
        }

        /* Black Hole Warp Flash */
        #warpFlash {
            position: fixed;
            inset: 0;
            background: radial-gradient(circle at center, #fff6dc 0%, #b4dcd0 50%, #0f1822 100%);
            opacity: 0;
            pointer-events: none;
            z-index: 25;
            transition: opacity 0.35s ease;
        }

        /* Minimalist Top HUD (Hidden on Title Screen) */
        #hud {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            padding: max(10px, env(safe-area-inset-top)) max(16px, env(safe-area-inset-right)) 10px max(16px, env(safe-area-inset-left));
            display: none;
            justify-content: space-between;
            align-items: center;
            pointer-events: none;
            z-index: 22;
        }

        #hud.active {
            display: flex;
        }

        .hud-group {
            display: flex;
            align-items: center;
            gap: 8px;
            pointer-events: auto;
            flex-wrap: wrap;
        }

        .pill {
            background: var(--glass-bg);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border: 1px solid var(--glass-border);
            border-radius: 999px;
            padding: 6px 13px;
            display: flex;
            align-items: center;
            gap: 7px;
            font-size: 0.82rem;
            font-weight: 500;
            letter-spacing: 0.03em;
            color: #eef2f0;
            box-shadow: 0 4px 18px rgba(0, 0, 0, 0.28);
        }

        .orb-dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: var(--warm-gold);
            box-shadow: 0 0 8px var(--warm-gold);
        }

        .hearts-container {
            display: flex;
            align-items: center;
            gap: 4px;
        }

        .heart-icon {
            width: 15px;
            height: 15px;
            color: var(--heart-red);
            filter: drop-shadow(0 0 5px rgba(232, 122, 122, 0.55));
            transition: transform 0.25s ease, opacity 0.25s ease;
        }

        .heart-icon.lost {
            color: rgba(238, 242, 240, 0.22);
            filter: none;
            transform: scale(0.82);
        }

        .icon-btn {
            appearance: none;
            -webkit-appearance: none;
            background: var(--glass-bg);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border: 1px solid var(--glass-border);
            color: #eef2f0;
            width: 38px;
            height: 38px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            touch-action: manipulation;
            transition: transform 0.15s ease, background 0.15s ease;
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.28);
            position: relative;
        }

        .icon-btn:active {
            transform: scale(0.92);
            background: rgba(143, 184, 168, 0.3);
        }

        .icon-btn.muted {
            opacity: 0.55;
        }

        .trophy-badge-count {
            position: absolute;
            top: -3px;
            right: -3px;
            background: var(--warm-gold);
            color: #18232c;
            font-size: 0.62rem;
            font-weight: 700;
            min-width: 15px;
            height: 15px;
            border-radius: 999px;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0 3px;
        }

        /* Floating Level Transition Banner */
        #levelBanner {
            position: fixed;
            top: 20%;
            left: 50%;
            transform: translate(-50%, -10px);
            text-align: center;
            pointer-events: none;
            opacity: 0;
            transition: opacity 0.55s ease, transform 0.55s ease;
            z-index: 21;
        }

        #levelBanner.show {
            opacity: 1;
            transform: translate(-50%, 0);
        }

        #levelBannerNum {
            font-size: 0.76rem;
            text-transform: uppercase;
            letter-spacing: 0.24em;
            color: var(--sage-bright);
            margin-bottom: 4px;
            text-shadow: 0 2px 12px rgba(0, 0, 0, 0.65);
        }

        #levelBannerName {
            font-size: 1.75rem;
            font-weight: 300;
            letter-spacing: 0.12em;
            color: var(--warm-gold);
            text-shadow: 0 4px 24px rgba(0, 0, 0, 0.7);
        }

        /* Live Achievement Unlock Toast */
        #achievementToast {
            position: fixed;
            top: max(58px, calc(env(safe-area-inset-top) + 48px));
            right: max(16px, env(safe-area-inset-right));
            background: rgba(16, 25, 34, 0.94);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(242, 232, 207, 0.45);
            border-radius: 14px;
            padding: 10px 16px;
            display: flex;
            align-items: center;
            gap: 11px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.38);
            transform: translateX(140%);
            opacity: 0;
            transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.35s ease;
            pointer-events: none;
            z-index: 65;
        }

        #achievementToast.show {
            transform: translateX(0);
            opacity: 1;
        }

        .toast-trophy {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            background: rgba(242, 232, 207, 0.16);
            color: var(--warm-gold);
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .toast-eyebrow {
            font-size: 0.64rem;
            text-transform: uppercase;
            letter-spacing: 0.16em;
            color: var(--sage-bright);
        }

        .toast-title {
            font-size: 0.88rem;
            font-weight: 600;
            color: var(--warm-gold);
        }

        /* Subtle Portrait Rotation Prompt (Shown only when viewW < viewH during play) */
        #rotateHint {
            position: fixed;
            bottom: 106px;
            left: 50%;
            transform: translateX(-50%);
            background: rgba(16, 25, 34, 0.86);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            border: 1px solid rgba(143, 184, 168, 0.38);
            color: var(--text-muted);
            padding: 6px 14px;
            border-radius: 999px;
            font-size: 0.74rem;
            letter-spacing: 0.04em;
            display: none;
            align-items: center;
            gap: 8px;
            z-index: 18;
            pointer-events: none;
            white-space: nowrap;
        }

        /* Overlays (Title, Pause, Achievements, Game Over, Victory) */
        .overlay {
            position: fixed;
            inset: 0;
            width: 100%;
            height: 100%;
            height: 100dvh;
            background: rgba(14, 22, 30, 0.78);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 20px;
            text-align: center;
            z-index: 50;
            pointer-events: auto;
            opacity: 1;
            visibility: visible;
            transition: opacity 0.3s ease;
        }

        .overlay.hidden {
            display: none !important;
            opacity: 0;
            pointer-events: none;
            visibility: hidden;
        }

        /* Ultra-Clean Minimalist Start Screen (ONLY Title & BEGIN JOURNEY Button) */
        #startOverlay {
            background: rgba(14, 22, 30, 0.56);
            backdrop-filter: blur(7px);
            -webkit-backdrop-filter: blur(7px);
            z-index: 50;
        }

        .title-eyebrow {
            font-size: 0.74rem;
            letter-spacing: 0.28em;
            text-transform: uppercase;
            color: var(--sage);
            margin-bottom: 8px;
        }

        .game-title {
            font-size: clamp(2.2rem, 6.2vw, 3.9rem);
            font-weight: 300;
            letter-spacing: 0.18em;
            color: var(--warm-gold);
            margin-bottom: 36px;
            text-shadow: 0 8px 32px rgba(242, 232, 207, 0.25);
        }

        .primary-btn {
            appearance: none;
            -webkit-appearance: none;
            background: linear-gradient(135deg, rgba(143, 184, 168, 0.42), rgba(143, 184, 168, 0.22));
            border: 1.5px solid rgba(143, 184, 168, 0.75);
            color: #eef2f0;
            font-family: inherit;
            padding: 15px 42px;
            border-radius: 999px;
            font-size: 0.98rem;
            font-weight: 600;
            letter-spacing: 0.16em;
            text-transform: uppercase;
            cursor: pointer;
            pointer-events: auto;
            touch-action: manipulation;
            transition: transform 0.15s ease, background 0.15s ease, border-color 0.15s ease;
            box-shadow: 0 8px 28px rgba(0, 0, 0, 0.32);
        }

        .primary-btn:hover {
            background: rgba(143, 184, 168, 0.5);
            border-color: var(--warm-gold);
            color: var(--warm-gold);
        }

        .primary-btn:active {
            transform: scale(0.95);
        }

        .secondary-btn {
            appearance: none;
            -webkit-appearance: none;
            background: rgba(18, 28, 38, 0.84);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            color: #eef2f0;
            border: 1px solid rgba(143, 184, 168, 0.45);
            border-radius: 999px;
            padding: 12px 24px;
            font-family: inherit;
            font-size: 0.84rem;
            font-weight: 500;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            cursor: pointer;
            pointer-events: auto;
            touch-action: manipulation;
            transition: transform 0.15s ease, background 0.15s ease;
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.28);
        }

        .secondary-btn:active {
            transform: scale(0.95);
            background: rgba(143, 184, 168, 0.28);
        }

        .overlay-actions {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            align-items: center;
            gap: 12px;
            max-width: 540px;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 12px;
            margin-bottom: 22px;
            width: 100%;
            max-width: 400px;
        }

        .stat-card {
            background: rgba(255, 255, 255, 0.06);
            border: 1px solid var(--glass-border);
            border-radius: 16px;
            padding: 12px 10px;
        }

        .stat-val {
            font-size: 1.3rem;
            font-weight: 500;
            color: var(--warm-gold);
            margin-bottom: 4px;
        }

        .stat-lbl {
            font-size: 0.68rem;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: var(--text-muted);
        }

        /* Achievements Modal List */
        .achievements-list {
            display: flex;
            flex-direction: column;
            gap: 9px;
            width: 100%;
            max-width: 470px;
            max-height: 54dvh;
            overflow-y: auto;
            margin-bottom: 20px;
            padding-right: 4px;
        }

        .ach-card {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(238, 242, 240, 0.14);
            border-radius: 14px;
            padding: 11px 14px;
            text-align: left;
            opacity: 0.58;
        }

        .ach-card.unlocked {
            opacity: 1;
            background: rgba(143, 184, 168, 0.16);
            border-color: rgba(242, 232, 207, 0.45);
        }

        .ach-info-title {
            font-size: 0.9rem;
            font-weight: 600;
            color: var(--warm-gold);
            margin-bottom: 2px;
        }

        .ach-info-desc {
            font-size: 0.76rem;
            color: var(--text-muted);
        }

        .ach-status {
            font-size: 0.7rem;
            font-weight: 600;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            padding: 4px 10px;
            border-radius: 999px;
            background: rgba(255, 255, 255, 0.08);
            color: var(--text-muted);
            white-space: nowrap;
        }

        .ach-card.unlocked .ach-status {
            background: rgba(242, 232, 207, 0.22);
            color: var(--warm-gold);
        }

        /* Touch Controls Layer (Shown ONLY during active gameplay) */
        #touchLayer {
            position: fixed;
            inset: 0;
            display: none;
            pointer-events: none;
            z-index: 15;
            touch-action: none;
        }

        #touchLayer.active {
            display: block;
        }

        /* Left Half Dynamic Virtual Joystick Touch Zone */
        #joystickZone {
            position: fixed;
            top: 56px;
            left: 0;
            bottom: 0;
            width: 52%;
            pointer-events: auto;
            touch-action: none;
            z-index: 16;
        }

        #joystickBase {
            position: fixed;
            width: 114px;
            height: 114px;
            margin-left: -57px;
            margin-top: -57px;
            border-radius: 50%;
            background: rgba(16, 25, 34, 0.56);
            backdrop-filter: blur(6px);
            -webkit-backdrop-filter: blur(6px);
            border: 1.5px solid rgba(242, 232, 207, 0.45);
            box-shadow: 0 8px 28px rgba(0, 0, 0, 0.3);
            pointer-events: none;
            display: none;
            z-index: 17;
        }

        #joystickThumb {
            position: absolute;
            top: 50%;
            left: 50%;
            width: 48px;
            height: 48px;
            margin-left: -24px;
            margin-top: -24px;
            border-radius: 50%;
            background: radial-gradient(circle at 35% 35%, rgba(242, 232, 207, 0.96), rgba(143, 184, 168, 0.85));
            box-shadow: 0 4px 14px rgba(0, 0, 0, 0.38);
        }

        /* Right Side Action Buttons (DASH & JUMP) */
        #touchControls {
            position: fixed;
            bottom: max(20px, env(safe-area-inset-bottom));
            right: max(22px, env(safe-area-inset-right));
            display: flex;
            align-items: flex-end;
            gap: 18px;
            pointer-events: auto;
            touch-action: none;
            z-index: 18;
        }

        .touch-btn {
            appearance: none;
            -webkit-appearance: none;
            width: 74px;
            height: 74px;
            border-radius: 50%;
            background: rgba(16, 25, 34, 0.74);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            border: 1.5px solid rgba(238, 242, 240, 0.38);
            color: #eef2f0;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            font-size: 0.84rem;
            font-weight: 700;
            letter-spacing: 0.06em;
            box-shadow: 0 6px 22px rgba(0, 0, 0, 0.35);
            touch-action: none;
            cursor: pointer;
            transition: transform 0.06s ease, background 0.06s ease, border-color 0.06s ease;
        }

        .touch-btn.pressed {
            background: rgba(143, 184, 168, 0.52);
            border-color: var(--warm-gold);
            color: var(--warm-gold);
            transform: scale(0.9);
        }

        .touch-btn.dash-btn {
            border-color: rgba(143, 184, 168, 0.62);
            color: var(--sage-bright);
        }

        .touch-btn.dash-btn.cooldown {
            opacity: 0.48;
        }
    </style>
</head>
<body>
    <canvas id="gameCanvas"></canvas>
    <div id="warpFlash"></div>

    <!-- Minimalist Top HUD (Hidden while on Title Screen) -->
    <div id="hud">
        <div class="hud-group">
            <div class="pill">
                <div class="hearts-container" id="hudHearts" title="Lives Remaining">
                    <svg class="heart-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
                    <svg class="heart-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
                    <svg class="heart-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
                </div>
            </div>
            <div class="pill">
                <span id="hudWorld">WORLD 1-1</span>
                <span style="opacity:0.35">•</span>
                <span id="hudTitle" style="color:var(--sage);">Starlit Awakening</span>
            </div>
            <div class="pill">
                <span class="orb-dot"></span>
                <span id="hudOrbs">0</span>
            </div>
        </div>

        <div class="hud-group">
            <!-- Achievements Trophy Button -->
            <button class="icon-btn" id="btnAchievements" type="button" title="Achievements" aria-label="Achievements">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/>
                    <path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/>
                    <path d="M4 22h16"/>
                    <path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/>
                    <path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/>
                    <path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/>
                </svg>
                <span class="trophy-badge-count" id="hudAchCount">0</span>
            </button>
            <!-- Pause / Resume Button -->
            <button class="icon-btn" id="btnPause" type="button" title="Pause / Resume" aria-label="Pause Game">
                <svg id="iconPause" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="6" y="4" width="4" height="16" rx="1"/>
                    <rect x="14" y="4" width="4" height="16" rx="1"/>
                </svg>
                <svg id="iconPlay" style="display:none;" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <polygon points="6 4 20 12 6 20 6 4"/>
                </svg>
            </button>
            <!-- Fullscreen / Landscape Lock Toggle -->
            <button class="icon-btn" id="btnFullscreen" type="button" title="Fullscreen Landscape Mode" aria-label="Fullscreen Landscape Mode">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M8 3H5a2 2 0 0 0-2 2v3"/>
                    <path d="M21 8V5a2 2 0 0 0-2-2h-3"/>
                    <path d="M3 16v3a2 2 0 0 0 2 2h3"/>
                    <path d="M16 21h3a2 2 0 0 0 2-2v-3"/>
                </svg>
            </button>
            <!-- Mute / Unmute Audio -->
            <button class="icon-btn" id="btnMute" type="button" title="Toggle Sound" aria-label="Toggle Sound">
                <svg id="iconSoundOn" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/>
                    <path d="M15.54 8.46a5 5 0 0 1 0 7.07"/>
                    <path d="M19.07 4.93a10 10 0 0 1 0 14.14"/>
                </svg>
                <svg id="iconSoundOff" style="display:none;" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/>
                    <line x1="23" y1="9" x2="17" y2="15"/>
                    <line x1="17" y1="9" x2="23" y2="15"/>
                </svg>
            </button>
        </div>
    </div>

    <!-- Live Achievement Unlock Toast -->
    <div id="achievementToast">
        <div class="toast-trophy">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/>
                <path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/>
                <path d="M4 22h16"/>
                <path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/>
                <path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/>
                <path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/>
            </svg>
        </div>
        <div>
            <div class="toast-eyebrow">Achievement Unlocked</div>
            <div class="toast-title" id="toastTitle">First Rift</div>
        </div>
    </div>

    <!-- Floating Level Transition Banner -->
    <div id="levelBanner">
        <div id="levelBannerNum">World 1-1</div>
        <div id="levelBannerName">Starlit Awakening</div>
    </div>

    <!-- Subtle Portrait Rotation Hint (Shown only when viewW < viewH during active gameplay) -->
    <div id="rotateHint">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#8fb8a8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="4" y="2" width="16" height="20" rx="2" ry="2" transform="rotate(90 12 12)"/>
        </svg>
        <span>Rotate to Landscape for optimal view</span>
    </div>

    <!-- Ultra-Clean Minimalist Start Screen (ONLY Title & BEGIN JOURNEY Button) -->
    <div id="startOverlay" class="overlay">
        <h1 class="game-title">AETHER DRIFT</h1>
        <button id="btnStart" type="button" class="primary-btn">BEGIN JOURNEY</button>
    </div>

    <!-- Pause Overlay Screen -->
    <div id="pauseOverlay" class="overlay hidden">
        <div class="title-eyebrow">Journey Paused</div>
        <h1 class="game-title" style="font-size: clamp(1.9rem, 5vw, 2.8rem); margin-bottom: 22px;">STILLNESS</h1>
        <div class="overlay-actions">
            <button id="btnResume" type="button" class="primary-btn">Resume</button>
            <button id="btnPauseAchievements" type="button" class="secondary-btn">Achievements</button>
            <button id="btnPauseRestart" type="button" class="secondary-btn">Restart Level</button>
            <button id="btnMainMenu" type="button" class="secondary-btn">Main Menu</button>
        </div>
